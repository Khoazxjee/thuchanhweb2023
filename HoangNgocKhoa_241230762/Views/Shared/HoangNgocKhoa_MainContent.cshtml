@model IEnumerable<HangHoa>

<div class="content_top">
    <div class="heading"><h3>Hoàng Ngọc Khoa</h3></div>
    <div class="see">
        <p><a asp-controller="Home" asp-action="Create">Thêm hàng hóa mới</a></p>
    </div>
    <div class="clear"></div>
</div>

@if (!Model.Any())
{
    <p style="padding: 20px 0;">Không có hàng hóa phù hợp.</p>
}

@foreach (var nhom in Model.Chunk(4))
{
    <div class="section group">
        @foreach (var hang in nhom)
        {
            <div class="grid_1_of_4 images_1_of_4">
                <img src="@Url.Content("~/Content/images/" + hang.Anh)" alt="@hang.TenHang" />
                <h2>@hang.TenHang</h2>
                <div class="price-details">
                    <div class="price-number">
                        <p><span class="rupees">@(hang.Gia?.ToString("0"))</span></p>
                    </div>
                    <div class="add-cart">
                        <h4><a href="#" onclick="return false;">Add to Cart</a></h4>
                    </div>
                    <div class="clear"></div>
                </div>
            </div>
        }
    </div>
}
