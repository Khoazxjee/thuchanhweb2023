@{
    var danhSachLoai = ViewBag.DanhSachLoai
        as IEnumerable<LoaiHang> ?? Enumerable.Empty<LoaiHang>();
    int? maLoaiDangChon = ViewBag.MaLoaiDangChon;
}

<div class="header">
    <div class="header_top">
        <div class="logo">
            <a asp-controller="Home" asp-action="Index">
                <img src="~/Content/images/logo.png" alt="Home Shoppe" />
            </a>
        </div>
        <div class="cart">
            <p>Welcome to our Online Store! <span>Cart:</span></p>
            <div id="dd" class="wrapper-dropdown-2">
                0 item(s) - $0.00
                <ul class="dropdown">
                    <li>you have no items in your Shopping cart</li>
                </ul>
            </div>
        </div>
        <div class="clear"></div>
    </div>

    <div class="header_bottom">
        <div class="menu">
            <ul>
                <li class="@(maLoaiDangChon == null ? "active" : "")">
                    <a class="loc-loai-hang"
                       asp-controller="Home" asp-action="Index"
                       data-url="@Url.Action("LocTheoLoai", "Home")">
                        Hoàng Ngọc Khoa
                    </a>
                </li>
                @foreach (var loai in danhSachLoai)
                {
                    <li class="@(maLoaiDangChon == loai.MaLoai ? "active" : "")">
                        <a class="loc-loai-hang"
                           asp-controller="Home" asp-action="Index"
                           asp-route-maLoai="@loai.MaLoai"
                           data-url="@Url.Action("LocTheoLoai", "Home", new { maLoai = loai.MaLoai })">
                            @loai.TenLoai
                        </a>
                    </li>
                }
            </ul>
            <div class="clear"></div>
        </div>
        <div class="search_box">
            <form onsubmit="return false;">
                <input type="text" placeholder="Search" />
                <input type="button" value="" />
            </form>
        </div>
        <div class="clear"></div>
    </div>
</div>
