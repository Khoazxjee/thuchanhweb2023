@model HangHoaCreateModel

<h2>Hoàng Ngọc Khoa</h2>
<h3>Thêm Hàng Hóa Mới</h3>
<hr />

<form asp-controller="Home" asp-action="Create" method="post">
    <div asp-validation-summary="All" style="color: #b91c1c;"></div>
    <div style="margin-bottom: 12px;">
        <label asp-for="MaLoai">Loại hàng</label><br />
        <select asp-for="MaLoai" asp-items="ViewBag.MaLoai">
            <option value="">Chọn loại hàng</option>
        </select>
        <span asp-validation-for="MaLoai" style="color: #b91c1c; display: block;"></span>
    </div>
    <div style="margin-bottom: 12px;">
        <label asp-for="TenHang">Tên hàng</label><br />
        <input asp-for="TenHang" />
        <span asp-validation-for="TenHang" style="color: #b91c1c; display: block;"></span>
    </div>
    <div style="margin-bottom: 12px;">
        <label asp-for="Gia">Giá</label><br />
        <input asp-for="Gia" />
        <span asp-validation-for="Gia" style="color: #b91c1c; display: block;"></span>
    </div>
    <div style="margin-bottom: 12px;">
        <label asp-for="Anh">Tên file ảnh</label><br />
        <input asp-for="Anh" />
        <span asp-validation-for="Anh" style="color: #b91c1c; display: block;"></span>
    </div>
    <button type="submit">Create</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
